{
  "manifest_version": 3,
  "name": "Daily Check Highlighter",
  "description": "日報テーブルで未入力や異常値を赤ハイライトする拡張機能",
  "version": "0.1.0",
  "content_scripts": [
    {
      "matches": [
        "https://daily-report.e4dev.info/members/*/daily*",
        "https://daily-report.e4dev.info/members/*/accept*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
